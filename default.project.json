{
  "name": "MazeRunner",
  "servePort": 34873,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      }
    },
    "ServerScriptService": {
      "$ignoreUnknownInstances": true,
      "$path": "src/server",
      "Packages": {
        "$path": "Packages"
      }
    },
    "StarterPlayer": {
      "$ignoreUnknownInstances": true,
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    }
  }
}
